# Demo works without any credentials. Copy this file to .env for live processing.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://freellm.gotiq.co/v1
OPENAI_MODEL=auto
DATA_DIR=data
SEED_DEMO=true

# Set only to a trusted LOCAL credential file. Never commit it.
# Supports Google service-account or authorized-user credentials.
GOOGLE_CREDENTIALS_FILE=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A:Y
